# Template for a live deployment. Copy to .env on the server and fill in real values.
# Never commit the filled-in version - .env is gitignored for this reason.
#
# Setting ENVIRONMENT=production turns on the startup checks in app/core/config.py: the
# server refuses to boot with the placeholder JWT secret, a wildcard CORS origin, or a
# plain-http origin. If it will not start, read the error - it lists every problem at once.

ENVIRONMENT=production

# Managed Postgres instance. Must be the asyncpg driver, and must use TLS.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/sgn?ssl=require

# Generate a fresh one, never reuse the development value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing session, which is the point if it leaks.
JWT_SECRET=
JWT_ALGORITHM=HS256

# Exact origins the frontend is served from, https only. No trailing slash, no wildcard:
# credentials are allowed on these requests, so a wildcard would let any site act as a
# logged-in member. Include every hostname that serves the site.
CORS_ORIGINS=["https://saudiglobal.co","https://www.saudiglobal.co"]

# Live secret key (sk_live_...). Leave empty to keep payments disabled, in which case the
# payment endpoints return a clean 503 and the free membership and RSVP paths still work.
# The publishable key in sbn-website's src/Member.js must come from the same Stripe mode.
STRIPE_SECRET_KEY=
