# Local development defaults. Copy to .env and these work as-is against
# `docker compose up -d`. See .env.production.example for a live deployment.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://sgn:sgn@localhost:5434/sgn
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
CORS_ORIGINS=["http://localhost:3000"]
STRIPE_SECRET_KEY=
